# true — демо для согласования: панель палитр, параметры ?palette и ?studio, noindex
# false — публичная версия: только утверждённая палитра, индексация разрешена
PUBLIC_REVIEW_MODE=true
# Палитра публичной версии: signal, olive-signal, olive, bronze, gold
PUBLIC_APPROVED_PALETTE=signal
# Фактический адрес сайта без подпапки, нужен для canonical и sitemap в публичной версии
PUBLIC_SITE_URL=
# Подпапка публикации, например /aixtex_concept/signal/ для GitHub Pages
BASE_PATH=/
