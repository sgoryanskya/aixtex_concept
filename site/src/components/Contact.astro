---
/* 12. Финал: призыв, форма заявки и подвал. Форма стандартная: имя, компания, телефон, почта, задача
   и согласие на обработку данных. Без обработчика (PUBLIC_FORM_ENDPOINT) заявка открывается письмом
   в почтовой программе посетителя, и форма говорит об этом заранее, не изображая отправку */
import { CONTACT, NAV } from '../data/content';
import { REVIEW_MODE, APPROVED_PALETTE, FORM_ENDPOINT, asset } from '../config';
import { COMPANY, REQUISITES, NOTICE } from '../data/company';

const req = Object.fromEntries(REQUISITES.map((r) => [r.label, r.value]));
const mail = COMPANY.email.href.replace(/^mailto:/, '');
const f = CONTACT.form;
/* лента ультрамарина в финале: только если палитра может быть на странице */
const ultra = REVIEW_MODE || APPROVED_PALETTE === 'ultra';
---
<section class="end" id="contact" data-ui="dark">
  <svg class="ln end__ln" data-ln="merge" aria-hidden="true"></svg>
  {ultra && <div class="end__art" aria-hidden="true"><img src={asset('img/art/hero-a-ultra.webp')} alt="" width="2000" height="1125" loading="lazy" decoding="async"></div>}
  <div class="wrap">
    <div class="end__grid">
      <div class="end__text">
        <h2 class="h2 h2--t">{CONTACT.title}</h2>
        <p>{CONTACT.text}</p>
        <ul>
          <li><a href={COMPANY.phone.href}>{COMPANY.phone.text}</a></li>
          <li><a href={COMPANY.email.href}>{COMPANY.email.text}</a></li>
        </ul>
      </div>
      <form class="form" data-form data-mailto={mail} data-subject={f.subject} data-endpoint={FORM_ENDPOINT || undefined} novalidate>
        <div class="form__body">
          <div class="form__head">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
          <div class="field" data-field>
            <label for="f-name">{f.name}<i aria-hidden="true">*</i></label>
            <input id="f-name" type="text" name="name" autocomplete="name" required aria-describedby="f-name-err" placeholder={f.namePh}>
            <em id="f-name-err">{f.nameErr}</em>
          </div>
          <div class="field" data-field>
            <label for="f-company">{f.company}</label>
            <input id="f-company" type="text" name="company" autocomplete="organization" placeholder={f.companyPh}>
          </div>
          <div class="field" data-field>
            <label for="f-phone">{f.phone}<i aria-hidden="true">*</i></label>
            <input id="f-phone" type="tel" name="phone" autocomplete="tel" inputmode="tel" required data-phone aria-describedby="f-phone-err" placeholder={f.phonePh}>
            <em id="f-phone-err">{f.phoneErr}</em>
          </div>
          <div class="field" data-field>
            <label for="f-email">{f.email}</label>
            <input id="f-email" type="email" name="email" autocomplete="email" inputmode="email" data-email aria-describedby="f-email-err" placeholder={f.emailPh}>
            <em id="f-email-err">{f.emailErr}</em>
          </div>
          <div class="field field--full" data-field>
            <label for="f-task">{f.task}</label>
            <textarea id="f-task" name="task" rows="4" placeholder={f.taskPh}></textarea>
          </div>
          <div class="check field--full" data-field>
            <input id="f-consent" type="checkbox" name="consent" required aria-describedby="f-consent-err">
            <label for="f-consent"><span class="check__box" aria-hidden="true"></span>{f.consent}&nbsp;<a href="#" data-stub={CONTACT.policy}>{f.policy}</a></label>
            <em id="f-consent-err">{f.consentErr}</em>
          </div>
          <div class="form__foot">
            <button class="btn form__send" type="submit" data-form-send data-busy={f.sending}><span>{f.submit}</span></button>
            {!FORM_ENDPOINT && <p class="form__note">{f.mailNote}</p>}
            <p class="form__fail" role="alert" data-form-fail hidden>{f.fail} <a href={COMPANY.phone.href}>{COMPANY.phone.text}</a>, <a href={COMPANY.email.href}>{COMPANY.email.text}</a></p>
          </div>
        </div>
        <div class="form__ok" aria-live="polite">
          <p class="lbl">{FORM_ENDPOINT ? f.sentLabel : f.okLabel}</p>
          <h3 tabindex="-1" data-form-ok>{FORM_ENDPOINT ? f.sentTitle : f.okTitle}</h3>
          <p>{FORM_ENDPOINT ? f.sentText : f.okText} <a href={COMPANY.email.href}>{COMPANY.email.text}</a></p>
          <button class="btn btn--ghost" type="button" data-form-reset><span>{f.again}</span></button>
        </div>
      </form>
    </div>
  </div>

  <footer class="foot">
    <div class="wrap">
      <p class="foot__logo" aria-hidden="true"><b>АИ</b>ТЕХ</p>
      <div class="foot__grid">
        <div>
          <p class="lbl">{CONTACT.footLabels.company}</p>
          <p>{req['Компания']}<br>ИНН {req['ИНН']} · ОГРН {req['ОГРН']}<br>{req['Адрес']}<br>ОКВЭД {req['ОКВЭД']}</p>
        </div>
        <div>
          <p class="lbl">{CONTACT.footLabels.sections}</p>
          <ul>{NAV.map((n) => <li>{n.href ? <a href={n.href}>{n.label}</a> : <a href="#" data-stub={n.stub}>{n.label}</a>}</li>)}</ul>
        </div>
        <div>
          <p class="lbl">{CONTACT.footLabels.notice}</p>
          <p>{NOTICE.text}</p>
          <p><a href="#" data-stub={CONTACT.policy}>{CONTACT.policy}</a></p>
        </div>
      </div>
    </div>
  </footer>
</section>
