---
/* 6. Анатомия A: снаружи один сотрудник, внутри три слоя. Плиты — фарфор, узлы базы знаний —
   бусины из металла палитры со связями-линиями. Цвета рисунка — классы от палитры */
import { INSIDE } from '../data/content';
---
<section class="ex" id="inside" data-ui="light" data-ex>
  <div class="ex__stage" data-ex-stage>
    <i class="cross cross--tl"></i><i class="cross cross--tr"></i><i class="cross cross--bl"></i><i class="cross cross--br"></i>
    <div class="ex__head">
      <p class="lbl">{INSIDE.label}</p>
      <h2 class="h2" data-split>{INSIDE.title}</h2>
    </div>
    <div class="ex__scene">
      <div class="ex__stack" data-ex-stack>
        <div class="plane plane--c" data-plane="0"><i class="plane__a" data-anchor="0"></i>
          <svg viewBox="0 0 400 300" aria-hidden="true"><g class="pl-1" fill="none" stroke-width="1"><rect x="26" y="28" width="150" height="46" rx="3"/><rect x="60" y="88" width="190" height="46" rx="3"/><rect x="26" y="148" width="120" height="46" rx="3"/><rect x="224" y="28" width="150" height="46" rx="3"/><rect x="274" y="88" width="100" height="46" rx="3"/><rect x="170" y="148" width="204" height="46" rx="3"/></g><g class="pl-2"><rect x="40" y="46" width="90" height="4"/><rect x="40" y="56" width="60" height="4"/><rect x="76" y="106" width="130" height="4"/><rect x="76" y="116" width="84" height="4"/><rect x="40" y="166" width="70" height="4"/><rect x="238" y="46" width="96" height="4"/><rect x="288" y="106" width="60" height="4"/><rect x="186" y="166" width="150" height="4"/></g><g class="pl-sig" data-ex-wave><rect x="26" y="232" width="4" height="22"/><rect x="36" y="224" width="4" height="38"/><rect x="46" y="236" width="4" height="14"/><rect x="56" y="218" width="4" height="50"/><rect x="66" y="228" width="4" height="30"/><rect x="76" y="238" width="4" height="10"/><rect x="86" y="222" width="4" height="42"/><rect x="96" y="232" width="4" height="22"/></g><g class="pl-3"><rect x="110" y="241" width="264" height="4"/></g></svg>
        </div>
        <div class="plane plane--k" data-plane="1"><i class="plane__a" data-anchor="1"></i>
          <svg viewBox="0 0 400 300" aria-hidden="true"><defs><radialGradient id="ex-bead" cx="0.36" cy="0.3" r="0.75"><stop class="bd-hi" offset="0"/><stop class="bd-li" offset="0.22"/><stop class="bd-ba" offset="0.62"/><stop class="bd-dk" offset="1"/></radialGradient><pattern id="ex-dots" width="16" height="16" patternUnits="userSpaceOnUse"><circle class="pl-4" cx="2" cy="2" r="1.1"/></pattern></defs><rect width="400" height="300" fill="url(#ex-dots)"/><g class="pl-5" fill="none" stroke-width="1"><path d="M50 66L130 34 226 82 330 50"/><path d="M130 34L114 146 226 82 306 162"/><path d="M50 66L114 146 66 226 194 242 306 162 354 242"/><path d="M226 82L194 242"/><path d="M330 50L306 162"/></g><ellipse class="bd-sh" cx="52" cy="71.6" rx="7" ry="3.5"/><circle cx="50" cy="66" r="7" fill="url(#ex-bead)"/><ellipse class="bd-sh" cx="132" cy="39.6" rx="7" ry="3.5"/><circle cx="130" cy="34" r="7" fill="url(#ex-bead)"/><ellipse class="bd-sh" cx="332" cy="55.6" rx="7" ry="3.5"/><circle cx="330" cy="50" r="7" fill="url(#ex-bead)"/><ellipse class="bd-sh" cx="116" cy="151.6" rx="7" ry="3.5"/><circle cx="114" cy="146" r="7" fill="url(#ex-bead)"/><ellipse class="bd-sh" cx="68" cy="230.8" rx="6" ry="3.0"/><circle cx="66" cy="226" r="6" fill="url(#ex-bead)"/><ellipse class="bd-sh" cx="196" cy="247.6" rx="7" ry="3.5"/><circle cx="194" cy="242" r="7" fill="url(#ex-bead)"/><ellipse class="bd-sh" cx="356" cy="246.8" rx="6" ry="3.0"/><circle cx="354" cy="242" r="6" fill="url(#ex-bead)"/><ellipse class="bd-sh" cx="228" cy="88.4" rx="8" ry="4.0"/><circle cx="226" cy="82" r="8" fill="url(#ex-bead)"/><ellipse class="bd-sh" cx="308" cy="169.2" rx="9" ry="4.5"/><circle cx="306" cy="162" r="9" fill="url(#ex-bead)"/></svg>
        </div>
        <div class="plane plane--t" data-plane="2"><i class="plane__a" data-anchor="2"></i>
          <svg viewBox="0 0 400 300" aria-hidden="true"><path class="pl-6" d="M30 40H370V72H30V104H370V136H30V168H370V200H30V232H370V262" fill="none" stroke-width="9" stroke-linejoin="round"/><path class="plane__flow" d="M30 40H370V72H30V104H370V136H30V168H370V200H30V232H370V262" fill="none" stroke-width="3" stroke-linejoin="round"/></svg>
        </div>
      </div>
    </div>
    <svg class="ex__lines" data-ex-lines aria-hidden="true"><path/><path/><path/></svg>
    <ol class="ex__labels">
      {INSIDE.layers.map((l, i) => <li data-ex-label={i}><i>{l.n}</i><b>{l.title}</b><span>{l.text}</span></li>)}
    </ol>
    <ul class="ex__foot">
      {INSIDE.foot.map((t) => <li>{t}</li>)}
    </ul>
  </div>
</section>
