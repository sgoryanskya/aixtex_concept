---
/* 4. Каталог A: штат от одного сотрудника до отдела. Бриф v3, блок 4: три карточки в ряд,
   сначала роли, линия масштаба «роль → отдел», затем отделы; сцены из фарфора и металла палитры.
   «Подробнее» открывает панель решения, плюс показывает задачи прямо в карточке */
import { CATALOG, nb } from '../data/content';
import { SOLUTIONS, type Solution } from '../data/solutions';
import { getPalette } from '../data/palettes';
import { START_PALETTE, asset } from '../config';
import SolutionDetails from './SolutionDetails.astro';

const art = getPalette(START_PALETTE).art;
const byId = (id: string) => SOLUTIONS.find((s) => s.id === id)!;
const roles = ['assistant', 'sales', 'support'].map(byId);
const units = ['sales-unit', 'call-center', 'corporate'].map(byId);
const custom = SOLUTIONS.find((s) => !s.tasks.length)!;
const withDetails = [...roles, ...units];
const scene = (s: Solution) => s.img.replace('clay-', '');
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="staff" id="staff" data-ui="light">
  <div class="wrap">
    <div class="sec-head">
      <p class="lbl">{CATALOG.label}</p>
      <h2 class="h2" data-split>{CATALOG.title}</h2>
      <p class="sec-head__sub" data-reveal>{CATALOG.sub}</p>
    </div>
    <div class="cards" data-cards>
      {withDetails.map((s, i) => (
        <>
          {i === roles.length && (
            <div class="scale" data-scale aria-hidden="true">
              <span>{CATALOG.scale[0]}</span>
              <i class="scale__line"></i>
              <span>{CATALOG.scale[1]}</span>
            </div>
          )}
          <article class="card" data-card>
            <div class="card__img">
              <img src={asset(`img/art/scene-${scene(s)}-${art}.webp`)} data-art-tpl={asset(`img/art/scene-${scene(s)}-{p}.webp`)} data-orig={asset(`img/${s.img}.webp`)} alt={s.alt} width="1120" height="840" loading="lazy" decoding="async">
              <script is:inline>window.__art && window.__art(document.currentScript.previousElementSibling);</script>
            </div>
            <p class="card__meta"><span>{num(i)}</span>{s.tag}</p>
            <div class="card__body">
              <h3>{nb(s.title)}</h3>
              <p>{nb(s.desc)}</p>
              <div class="card__foot">
                <button class="btn btn--line" type="button" data-open-dialog={`sol-${s.id}`} aria-haspopup="dialog"><span>{CATALOG.more}</span><i class="arr"></i></button>
                <button class="plus plus--line" type="button" data-card-toggle aria-label="Показать задачи" aria-expanded="false" aria-controls={`tasks-${s.id}`}><i></i></button>
              </div>
            </div>
            <ul class="card__tasks" id={`tasks-${s.id}`}>
              {s.tasks.map((t) => <li>{nb(t)}</li>)}
            </ul>
          </article>
        </>
      ))}
      <article class="card card--custom">
        <div class="card__img">
          <img src={asset(`img/art/scene-${scene(custom)}-${art}.webp`)} data-art-tpl={asset(`img/art/scene-${scene(custom)}-{p}.webp`)} data-orig={asset(`img/${custom.img}.webp`)} alt={custom.alt} width="1120" height="840" loading="lazy" decoding="async">
          <script is:inline>window.__art && window.__art(document.currentScript.previousElementSibling);</script>
        </div>
        <p class="card__meta"><span>{num(withDetails.length)}</span>{custom.tag}</p>
        <div class="card__body">
          <h3>{nb(custom.title)}</h3>
          <p>{nb(custom.desc)}</p>
          <div class="card__foot"><a class="btn" href="#contact"><span>{CATALOG.customCta}</span></a></div>
        </div>
      </article>
      <article class="card card--more">
        <p class="lbl">{CATALOG.moreLabel}</p>
        <ul class="card__more">
          {CATALOG.moreList.map((t) => <li>{nb(t)}</li>)}
        </ul>
        <a class="more-link" href="#" data-stub="Каталог решений"><span>{CATALOG.moreLink}</span><i></i></a>
        <p class="card__note">{CATALOG.note}</p>
      </article>
    </div>
  </div>
  {withDetails.map((s) => <SolutionDetails solution={s} scene={scene(s)} art={art} />)}
</section>
