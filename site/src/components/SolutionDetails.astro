---
/* Панель подробностей решения на нативном <dialog>: лист-спецификация в языке A.
   Сцена во всю ширину с перекрестьями, заголовок капслоком, разделы строками «метка | текст» */
import type { Solution } from '../data/solutions';
import { CATALOG, nb } from '../data/content';
import { asset } from '../config';

interface Props {
  solution: Solution;
  scene: string;
  art: string;
}
const { solution: s, scene, art } = Astro.props;
---
<dialog class="drawer" id={`sol-${s.id}`} aria-labelledby={`sol-${s.id}-t`}>
  <div class="drawer__top">
    <span>{CATALOG.label} <b>/</b> {s.tag}</span>
    <button class="drawer__x" type="button" data-close-dialog aria-label="Закрыть"><i></i></button>
  </div>
  <div class="drawer__img">
    <img src={asset(`img/art/scene-${scene}-${art}.webp`)} data-art-tpl={asset(`img/art/scene-${scene}-{p}.webp`)} data-orig={asset(`img/${s.img}.webp`)} alt="" width="1120" height="840" loading="lazy" decoding="async">
    <script is:inline>window.__art && window.__art(document.currentScript.previousElementSibling);</script>
    <i class="cross" style="left:16px;top:16px"></i><i class="cross" style="right:16px;top:16px"></i>
    <i class="cross" style="left:16px;bottom:16px"></i><i class="cross" style="right:16px;bottom:16px"></i>
  </div>
  <div class="drawer__in">
    <h2 id={`sol-${s.id}-t`}>{nb(s.title)}</h2>
    <p class="drawer__desc">{nb(s.desc)}</p>
    <dl class="drawer__spec">
      <div>
        <dt class="lbl">Задача</dt>
        <dd><p>{nb(s.details.goal)}</p></dd>
      </div>
      <div>
        <dt class="lbl">Сценарий работы</dt>
        <dd><ol class="drawer__flow">{s.details.flow.map((f) => <li>{nb(f)}</li>)}</ol></dd>
      </div>
      <div>
        <dt class="lbl">Что получает команда</dt>
        <dd><ul class="drawer__list">{s.details.team.map((f) => <li>{nb(f)}</li>)}</ul></dd>
      </div>
      <div>
        <dt class="lbl">Возможные интеграции</dt>
        <dd>
          <ul class="drawer__list">{s.details.integrations.map((f) => <li>{nb(f)}</li>)}</ul>
          <p class="drawer__fine">{nb('Состав функций и интеграций уточняется под задачу компании на этапе проектирования.')}</p>
        </dd>
      </div>
    </dl>
  </div>
  <div class="drawer__cta">
    <a class="btn" href="#contact"><span>Обсудить задачу</span></a>
    <button class="btn btn--line" type="button" data-close-dialog><span>К каталогу</span></button>
  </div>
</dialog>
